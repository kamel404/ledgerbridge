{
  "name": "@ledgerbridge/shared",
  "version": "0.0.1",
  "private": true,
  "description": "Event schemas (zod) and types shared by LedgerBridge services",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "oxlint": "^1.58.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
