# Local development only. Copy to .env and adjust.
# These values are fake and only used on your machine. Real secrets live in
# AWS Secrets Manager from Phase 4 on and are never committed or put in .env.

# Ports
MOCK_ERP_PORT=3001
INTEGRATION_SERVICE_PORT=3000

# Mock ERP: the OAuth client the integration service logs in with (Phase 1)
MOCK_ERP_CLIENT_ID=local-client
MOCK_ERP_CLIENT_SECRET=local-dev-secret-change-me
MOCK_ERP_JWT_SECRET=local-jwt-signing-key-change-me
MOCK_ERP_TOKEN_TTL_SECONDS=3600

# Integration service: where the ERP is (Phase 2)
ERP_BASE_URL=http://localhost:3001

# Integration service: webhook signing secrets, one per source app (Phase 2)
WEBHOOK_SECRET_BILLING=local-billing-secret
WEBHOOK_SECRET_PROCUREMENT=local-procurement-secret

# Mock ERP chaos (Phase 1). 0 = off.
CHAOS_ERROR_RATE=0
CHAOS_LATENCY_MS=0
# Max ERP requests per second before 429. 0 = no limit.
RATE_LIMIT_PER_SECOND=25
