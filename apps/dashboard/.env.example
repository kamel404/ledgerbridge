# Copy to .env.local (git-ignored), or run `npm run dashboard:env` from the repo root.
# Read only on the Next.js server: never exposed to the browser (no NEXT_PUBLIC_ prefix).

# Where the admin API is: the deployed API Gateway URL, or http://localhost:3000 locally.
ADMIN_API_URL=http://localhost:3000
# Must match the integration service's admin key (ADMIN_API_KEY in .env, or ledgerbridge/admin on AWS).
ADMIN_API_KEY=local-admin-key
