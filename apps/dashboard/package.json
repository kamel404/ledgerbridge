{
  "name": "dashboard",
  "version": "0.0.1",
  "private": true,
  "description": "LedgerBridge operator dashboard (Next.js). Runs locally or as an AWS Lambda Web Function.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3002",
    "build": "next build",
    "build:lambda": "next build && node scripts/package-web.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3002",
    "lint": "oxlint app/ lib/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.93.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1167.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  }
}
